generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ExpenseType {
  FIXED
  VARIABLE
  CARD
  SUBSCRIPTION
}

enum BoxEntryType {
  DEPOSIT
  WITHDRAW
}

enum InvestmentType {
  RENDA_FIXA
  RENDA_VARIAVEL
  FUNDO
  CRIPTO
  PREVIDENCIA
  OUTRO
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String    @default("#0f6bff")
  icon      String    @default("CircleDollarSign")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]
}

model Expense {
  id          String          @id @default(cuid())
  description String
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime
  type        ExpenseType     @default(VARIABLE)
  payment     String?         @default("Conta principal")
  notes       String?
  categoryId  String
  category    ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([date])
  @@index([categoryId])
}

model SavingBox {
  id          String     @id @default(cuid())
  name        String
  description String?
  target      Decimal    @db.Decimal(12, 2)
  deadline    DateTime?
  color       String     @default("#0f6bff")
  icon        String     @default("PiggyBank")
  archived    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  entries     BoxEntry[]
}

model BoxEntry {
  id        String       @id @default(cuid())
  boxId     String
  box       SavingBox    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  type      BoxEntryType
  amount    Decimal      @db.Decimal(12, 2)
  date      DateTime
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([boxId])
  @@index([date])
}

model Investment {
  id          String             @id @default(cuid())
  name        String
  type        InvestmentType     @default(OUTRO)
  institution String?
  goal        Decimal?           @db.Decimal(12, 2)
  color       String             @default("#0f6bff")
  archived    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  records     InvestmentRecord[]
}

model InvestmentRecord {
  id                  String     @id @default(cuid())
  investmentId        String
  investment          Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  date                DateTime
  investedAmount      Decimal    @db.Decimal(12, 2)
  currentValue        Decimal    @db.Decimal(12, 2)
  monthlyContribution Decimal    @default(0) @db.Decimal(12, 2)
  note                String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([investmentId])
  @@index([date])
}

model NetWorthSnapshot {
  id          String   @id @default(cuid())
  date        DateTime
  cash        Decimal  @default(0) @db.Decimal(12, 2)
  otherAssets Decimal  @default(0) @db.Decimal(12, 2)
  liabilities Decimal  @default(0) @db.Decimal(12, 2)
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([date])
  @@index([date])
}
